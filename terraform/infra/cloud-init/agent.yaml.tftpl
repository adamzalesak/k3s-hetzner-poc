#cloud-config
package_update: true

write_files:
  - path: /etc/netplan/60-private.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        ethernets:
          private:
            match:
              name: "en*"
            dhcp4: true
            optional: true
            mtu: 1450
  - path: /usr/local/bin/k3s-install.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      read -r PRIVATE_IFACE PRIVATE_CIDR < <(ip -4 -br addr show | awk '/^en/ {print $1, $3; exit}')
      if [ -z "$${PRIVATE_IFACE:-}" ] || [ -z "$${PRIVATE_CIDR:-}" ]; then
        echo "ERROR: could not detect private interface/IP" >&2
        exit 1
      fi
      PRIVATE_IP="$${PRIVATE_CIDR%/*}"
      curl -sfL https://get.k3s.io | \
        K3S_TOKEN="${k3s_token}" \
        K3S_URL="https://${control_plane_ip}:6443" \
        sh -s - agent \
          --node-ip "$PRIVATE_IP" \
          --flannel-iface "$PRIVATE_IFACE"

runcmd:
  - netplan apply
  - until ip -4 -br addr show | grep -E '^en.*UP.*10\.' > /dev/null; do echo "waiting for private NIC..."; sleep 5; done
  - until curl -sk -o /dev/null --connect-timeout 5 https://${control_plane_ip}:6443; do echo "waiting for control-plane API..."; sleep 5; done
  - /usr/local/bin/k3s-install.sh
