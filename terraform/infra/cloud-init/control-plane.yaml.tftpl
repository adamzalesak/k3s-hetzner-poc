#cloud-config
package_update: true

write_files:
  - path: /etc/netplan/60-private.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        ethernets:
          private:
            match:
              name: "en*"
            dhcp4: true
            optional: true

runcmd:
  - netplan apply
  - until ip -4 -br addr show | grep -E '^en.*UP.*10\.' > /dev/null; do echo "waiting for private NIC..."; sleep 5; done
  - curl -sfL https://get.k3s.io | K3S_TOKEN="${k3s_token}" sh -s - server --tls-san "$(curl -s http://169.254.169.254/hetzner/v1/metadata/public-ipv4)"
