#cloud-config
package_update: true

write_files:
  - path: /etc/netplan/60-private.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        ethernets:
          private:
            match:
              name: "en*"
            dhcp4: true
            optional: true
  - path: /usr/local/bin/k3s-install.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      PRIVATE_IP=$(ip -4 -br addr show | awk '/^en/ {print $3}' | head -1 | cut -d/ -f1)
      if [ -z "$PRIVATE_IP" ]; then
        echo "ERROR: could not detect private IP" >&2
        exit 1
      fi
      PUBLIC_IP=$(curl -s http://169.254.169.254/hetzner/v1/metadata/public-ipv4)
      curl -sfL https://get.k3s.io | \
        K3S_TOKEN="${k3s_token}" \
        sh -s - server --tls-san "$PUBLIC_IP" --node-ip "$PRIVATE_IP"

runcmd:
  - netplan apply
  - until ip -4 -br addr show | grep -E '^en.*UP.*10\.' > /dev/null; do echo "waiting for private NIC..."; sleep 5; done
  - /usr/local/bin/k3s-install.sh
